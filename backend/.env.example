# Copy to backend/.env. Never commit the real file or copy it into an image.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
# Bedrock API key; requires Boto3 >= 1.39.
AWS_BEARER_TOKEN_BEDROCK=

# Optional online fallback: used only when no local curriculum evidence matches.
# Wikipedia search needs no key. Set WEB_SEARCH_ENABLED=false to disable the online fallback.
WEB_SEARCH_ENABLED=true
WIKIPEDIA_LANG=en

# Index backends. Defaults keep retrieval and graph reads offline in SQLite.
# Set to qdrant / neo4j to use the derived indexes (requires the services below).
KAG_VECTOR_BACKEND=sqlite
KAG_GRAPH_BACKEND=sqlite
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# Authorization decisions: set to an OPA endpoint to evaluate deployment/policies/education.rego.
# Empty means the same rule is evaluated in-process.
OPA_URL=
