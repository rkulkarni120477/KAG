# Worker service: ingestion and maintenance jobs consumed from the Redis queue.
# The same image runs the scheduler with the "scheduler" command.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt && useradd --create-home kag
COPY app ./app
USER kag
CMD ["python", "-m", "app.worker", "run"]
