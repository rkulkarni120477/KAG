# Source service: the only container that mounts the SQLite database. Run as a single process.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 KAG_DATA_DIR=/data
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt && useradd --create-home kag && mkdir /data && chown kag:kag /data
COPY app ./app
USER kag
VOLUME ["/data"]
EXPOSE 8001
HEALTHCHECK --interval=20s --timeout=5s --start-period=20s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8001/internal/health', timeout=3)"
CMD ["uvicorn", "app.source.main:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "1", "--no-access-log"]
