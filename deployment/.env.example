# Copy to deployment/.env. Replace every placeholder with reviewed digests and random local secrets.
# Image references use repository@sha256:<64 hex characters>. Never commit the real .env.

# Dependency images (pinned digests)
QDRANT_IMAGE=qdrant/qdrant@sha256:REPLACE_WITH_APPROVED_1_20_DIGEST
NEO4J_IMAGE=neo4j@sha256:REPLACE_WITH_APPROVED_COMMUNITY_DIGEST
REDIS_IMAGE=redis@sha256:REPLACE_WITH_APPROVED_REDIS8_DIGEST
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak@sha256:REPLACE_WITH_APPROVED_DIGEST
OPA_IMAGE=openpolicyagent/opa@sha256:REPLACE_WITH_APPROVED_DIGEST
CADDY_IMAGE=caddy@sha256:REPLACE_WITH_APPROVED_DIGEST

# Application images (built locally from this repository)
SOURCE_IMAGE=kag-source:local
API_IMAGE=kag-api:local
WORKER_IMAGE=kag-worker:local
WEB_IMAGE=kag-web:local

# Secrets (random, local only)
SOURCE_SERVICE_TOKEN=REPLACE_WITH_RANDOM_SECRET
QDRANT_API_KEY=REPLACE_WITH_RANDOM_SECRET
NEO4J_PASSWORD=REPLACE_WITH_RANDOM_SECRET
REDIS_PASSWORD=REPLACE_WITH_RANDOM_SECRET
KEYCLOAK_ADMIN=local-admin
KEYCLOAK_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_SECRET

# AWS / Bedrock (optional). Leave empty for the offline evidence-only mode.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
BEDROCK_EMBED_MODEL_ID=

# Online fallback and cache
WEB_SEARCH_ENABLED=false
WEB_CACHE_DAYS=30
WEB_PURGE_INTERVAL_HOURS=6
